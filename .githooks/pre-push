#!/usr/bin/env bash
# Runs the unit checks (tests/run.sh --unit: unit tests, art check, lint) before a push and
# blocks the push when one fails. It checks every push, whatever the branch or tag, except one
# that only deletes refs. Enable it once per checkout:
#   git config core.hooksPath .githooks
# Bypass it on purpose with `git push --no-verify`.

set -u
cd "$(dirname "$0")/.." || exit 2

# Git gives one line per ref on standard input: <local ref> <local sha> <remote ref> <remote sha>.
# A deletion has an all-zero local sha and leaves nothing to check; no line at all means
# nothing to push.
checked=0
while read -r _ local_sha _; do
  [[ $local_sha =~ ^0+$ ]] || checked=1
done
((checked)) || exit 0

# A hook runs in a non-interactive shell, where mise's activation does not happen, so the
# pinned tools are reached through `mise exec`.
run=(tests/run.sh --unit)
command -v mise >/dev/null && run=(mise exec -- "${run[@]}")

if ! "${run[@]}"; then
  echo "pre-push: the unit checks failed, nothing was pushed (git push --no-verify skips them)." >&2
  exit 1
fi
